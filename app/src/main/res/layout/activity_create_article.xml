<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/et_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập tiêu đề bài viết" />

    <EditText
        android:id="@+id/et_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minLines="5"
        android:gravity="top|start"
        android:hint="Nhập nội dung bài viết" />

    <!-- Thêm phần chọn ảnh bìa bằng RadioGroup đã học -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Chọn ảnh bìa:"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rb_image1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ảnh 1"
            android:checked="true" /> <!-- Mặc định chọn ảnh 1 -->

        <RadioButton
            android:id="@+id/rb_image2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ảnh 2"
            android:layout_marginStart="16dp" />

        <RadioButton
            android:id="@+id/rb_image3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ảnh 3"
            android:layout_marginStart="16dp" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Lưu Bài Viết" />
</LinearLayout>